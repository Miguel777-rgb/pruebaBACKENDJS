      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/makis",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "makis"
          ]
